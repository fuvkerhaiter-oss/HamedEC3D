# Public (browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Customer Authentication (Supabase Auth + Resend + Google OAuth)
# In production, Supabase Auth sends email OTP codes through Resend using Custom SMTP in the Supabase Dashboard:
#   Host: smtp.resend.com | Port: 465 or 587 | User: resend | Password: <RESEND_API_KEY>
# Google OAuth is enabled in Supabase Dashboard -> Auth -> Providers -> Google with Client ID & Secret from Google Cloud Console.

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
PAYMENT_PROVIDER=stripe            # stripe | dev-simulator
STRIPE_SECRET_KEY=                 # sk_test_... until live is approved
STRIPE_WEBHOOK_SECRET=             # whsec_...
DEV_PAYMENT_WEBHOOK_SECRET=
# Signs guest order links (/order?id=…&t=…). REQUIRED in production, 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_LINK_SECRET=
STRIPE_ALLOW_LIVE=false            # set true only after the Stripe account is activated and tested

# Customer emails (order confirmation, shipped, refund) via Resend: https://resend.com (verify your domain there)
RESEND_API_KEY=
EMAIL_FROM=                        # e.g. WEGO SHIIIP <orders@your-domain.com>
EMAIL_REPLY_TO=                    # where customer replies go, e.g. support@your-domain.com
SUPPORT_EMAIL=                     # inbox that receives contact-form messages
# Protects /api/cron/maintenance and /api/cron/fulfillment (Vercel Cron sends it automatically). 16+ random chars.
CRON_SECRET=

# AliExpress Dropshipping API (AliExpress Open Platform app, approved for the DS API). Server only — never NEXT_PUBLIC_.
# Access token = OAuth token of YOUR AliExpress BUYER account authorised for the app (expires: refresh it before it lapses).
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_API_URL=                # default https://api-sg.aliexpress.com/sync
ALIEXPRESS_CURRENCY=USD            # supplier cost currency for quotes (USD or EUR)

# Direct PostgreSQL connection (server only). Required by the admin dashboard; when set, the catalog and
# 3D store also read from it. Supabase: Project Settings → Database → Connection string → Transaction pooler (port 6543).
# Local development: `npm run db:local` prints postgres://postgres:postgres@127.0.0.1:54329/postgres
DATABASE_URL=

# Product images (Admin → Products → Image Manager) are stored in Supabase Storage bucket "products" using
# NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SECRET_KEY (server only). Without them, development stores images on this
# computer (%LOCALAPPDATA%megamarket-media, served by /api/media); production refuses uploads.
# LOCAL_MEDIA_DIR=          # optional override of the development image folder

# Optional TURN relay for 3D-store voice chat (users behind strict NATs). Public by nature: use short-lived or restricted creds.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# 5 labelled demo bot shoppers in the 3D store (cosmetic only). Unset = on in development, off in production.
# NEXT_PUBLIC_STORE_BOTS=off
